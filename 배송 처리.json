    {
      "parameters": {
        "jsCode": "// 'Get Orders (배송 준비)' 노드에서 조회한 결과 가져오기\nconst rows = $items('Get Orders (배송 준비)', 0, 0).map(item => item.json);\n\n// ----- 도우미: 어떤 타입이 와도 보기 좋은 문자열로 변환 -----\nfunction toText(cell) {\n  if (cell == null) return \"\";\n  if (Array.isArray(cell)) {\n    return cell.map(toText).filter(Boolean).join(\", \");\n  }\n  if (typeof cell === \"object\") {\n    // Baserow 링크/룩업: {id, value} 또는 {name,label,email,text,...}\n    return String(\n      cell.value ?? cell.name ?? cell.label ?? cell.email ?? cell.text ?? \"\"\n    ).trim();\n  }\n  return String(cell).trim();\n}\n\n// 각 행에서 필요한 값 뽑기\nconst lines = rows.map((r, idx) => {\n  const product = toText(r[\"주문 상품\"]);\n  const ea = toText(r[\"주문 수량\"]); // 링크/선택/텍스트 다 대응\n  const customer = toText(r[\"주문 고객\"]);\n  // 주문 테이블에 이메일 칼럼명이 다를 수 있어 가장 가능성 높은 키들을 순서대로 조회\n  const email = toText(r[\"주문자 이메일\"] ?? r[\"고객 이메일\"] ?? r[\"이메일\"]);\n  const address = toText(r[\"주소지\"]);\n\n  const emailPart = email ? ` <${email}>` : \"\";\n  return `${idx + 1}. ${product} ${ea}개 - ${customer}${emailPart} - ${address}`;\n});\n\nconst body = lines.length\n  ? `[배송 준비 목록 보고]\\n\\n${lines.join(\"\\n\")}\\n\\n총 ${lines.length}건`\n  : \"배송 준비 상태의 주문이 없습니다.\";\n\nreturn [{\n  json: {\n    to: \"iuandn63@gmail.com\",\n    subject: \"[배송 준비 목록 보고]\",\n    text: body\n  }\n}];"
      },
