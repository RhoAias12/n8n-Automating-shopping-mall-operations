      "parameters": {
        "jsCode": "function toText(cell) {\n  if (cell == null) return \"\";\n  if (Array.isArray(cell)) {\n    return cell.map(toText).filter(Boolean).join(\", \");\n  }\n  if (typeof cell === \"object\") {\n    return String(\n      cell.value ?? cell.name ?? cell.label ?? cell.email ?? cell.text ?? \"\"\n    ).trim();\n  }\n  return String(cell).trim();\n}\n\nconst orders = $input.all();\n\nreturn orders\n  .map(item => {\n    const r = item.json;\n\n    const orderId = r.id;\n    const customerEmail = toText(r[\"주문 고객\"]);\n    const customerName = toText(r[\"주문 고객 이름\"] ?? r[\"고객명\"]);\n    \n    // ★ [추가됨] 상품명 가져오기\n    // 데이터베이스의 컬럼명이 \"주문 상품\"이 맞는지 확인해주세요.\n    const productName = toText(r[\"주문 상품\"]); \n\n    if (!customerEmail) {\n      console.warn(`[경고] 주문 ID ${orderId} → 이메일 없음, 발송 제외 됨`);\n      return null;\n    }\n\n    const subject = \"[리뷰 요청]\";\n    const greetingName = customerName ? `${customerName} 고객님` : `고객님`;\n    \n    // ★ [변경됨] 상품명이 있으면 상품명을, 없으면 \"주문하신 상품\"이라고 표시\n    const itemMention = productName ? productName : \"주문하신 상품\";\n    \n    const reviewLink = \"https://forms.gle/wrQJyHVx9frg3Vmt8\";\n\n    // 문구 수정: \"상품A 잘 받으셨나요?\" 처럼 자연스럽게 연결\n    const bodyText = `${greetingName}, ${itemMention} 잘 받으셨나요? 만족하셨다면 리뷰 부탁드립니다!\n\n리뷰 링크 → ${reviewLink}`;\n\n    return {\n      json: {\n        to: customerEmail,\n        subject,\n        text: bodyText,\n        id: orderId\n      }\n    };\n  })\n  .filter(Boolean);"
      },
