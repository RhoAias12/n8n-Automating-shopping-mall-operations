        "jsCode": "// 모든 주문을 모아 누적 매출 계산\nconst rows = $items('Get Orders (전체)').map(i => i.json);\nconst get = (obj, k) => (obj?.[k] ?? obj?.fields?.[k] ?? 0);\n\nconst totalRevenue = rows.reduce((acc, r) => acc + Number(get(r, '주문 총액') || 0), 0);\nconst orderCount   = rows.length;\n\nfunction fmt(n){ try { return new Intl.NumberFormat('ko-KR').format(Math.round(n)); } catch { return String(n); } }\n\nreturn {\n  to: $env.FINANCE_EMAIL || $env.CARRIER_EMAIL || 'iuandn63@gmail.com',\n  subject: `월간 보고서 - 누적 매출 ${fmt(totalRevenue)}원 (총 ${orderCount}건)`,\n  text: [\n    '월 1회 누적 매출 보고서',\n    `총 주문 수: ${orderCount}건`,\n    `누적 매출 합계: ${fmt(totalRevenue)}원`,\n    '',\n    '※ 기준: Baserow 주문 테이블(전체 기간, \"주문 총액\" 합계)'\n  ].join('\\n')\n};"
      },
